+    uint32_t watch_lo_ = 0, watch_hi_ = 0;
+    uint64_t watch_overlap_stores_ = 0;
+    IwramCodeCb watch_cb_ = nullptr;
+    void* watch_user_ = nullptr;
+    // Cold path of the barrier: only reached when the store overlaps the range.
+    void iwram_watch_store(std::size_t off, uint8_t width, uint32_t v) {
+        ++watch_overlap_stores_;
+        // Only bytes inside [watch_lo_, watch_hi_) count: a straddling store that changes just
+        // out-of-range bytes leaves the code image untouched.
+        for (uint8_t i = 0; i < width; ++i) {
+            const std::size_t o = off + i;
