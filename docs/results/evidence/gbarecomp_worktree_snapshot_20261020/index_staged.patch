+    // VBlank blank lines advance the PPU to the next frame. The captured
+    // frame remains stable while page 1 is being scanned out.
+    for (uint32_t y = gba::GbaPpu::kLinesVisible;
+         y < gba::GbaPpu::kLinesTotal; ++y) {
+        const auto blank_line = f.ppu.tick(gba::GbaPpu::kDotsPerScanline *
