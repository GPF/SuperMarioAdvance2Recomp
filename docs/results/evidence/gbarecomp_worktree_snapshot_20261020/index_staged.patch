+        f.ppu.latched_framebuffer() + gba::GbaPpu::kFramebufferBytes);
+    const std::vector<uint16_t> latched_rgb565(
+        f.ppu.latched_framebuffer_rgb565(),
+        f.ppu.latched_framebuffer_rgb565() +
