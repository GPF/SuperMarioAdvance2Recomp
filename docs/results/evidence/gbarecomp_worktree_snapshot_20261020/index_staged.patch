+    // ── IWRAM code watch (scratch PoC) ─────────────────────────────────
+    // Optional exact write barrier for relocated IWRAM AOT code. When armed
+    // (hi > lo) every bus store that overlaps [lo,hi) AND changes a byte calls
+    // `cb(user, why)`. Bulk writers that bypass write8/16/32 call
+    // iwram_code_invalidate(). Disarmed: one predicted-untaken branch per
+    // IWRAM store.
+    using IwramCodeCb = void (*)(void* user, const char* why);
+    void set_iwram_code_watch(uint32_t lo, uint32_t hi, IwramCodeCb cb, void* user) {
