+            0xF800u) {
+        std::fprintf(stderr, "in-progress RGB565 work frame has wrong page mix\n");
+        std::exit(1);
+    }
+    for (uint32_t y = gba::GbaPpu::kScreenHeight / 2;
+         y < gba::GbaPpu::kScreenHeight; ++y) {
+        const auto hblank = f.ppu.tick(gba::GbaPpu::kDotsVisible *
+                                        gba::GbaPpu::kCyclesPerDot);
+        if (!hblank.hblank_started) std::exit(1);
+        f.ppu.render_scanline(y, 0x0414, f.io.data(), f.vram.data(),
+                              f.oam.data(), f.pal.data());
+        const auto end_line = f.ppu.tick(
+            (gba::GbaPpu::kDotsPerScanline - gba::GbaPpu::kDotsVisible) *
+            gba::GbaPpu::kCyclesPerDot);
+        if (end_line.vblank_started != (y + 1 == gba::GbaPpu::kScreenHeight))
+            std::exit(1);
+        if (end_line.vblank_started) f.ppu.mark_framebuffer_latched();
+    }
+    expect_sidecar_matches_rgb888(f.ppu.latched_framebuffer(),
+                                  f.ppu.latched_framebuffer_rgb565(),
+                                  gba::GbaPpu::kScreenWidth *
+                                      gba::GbaPpu::kScreenHeight,
+                                  "page 1 VBlank latch");
+    if (f.ppu.latched_framebuffer_rgb565()[0] != 0x001Fu ||
+        f.ppu.latched_framebuffer_rgb565()[1] != 0x07E0u) {
+        std::fprintf(stderr, "RGB565 page 1 latch does not reflect page flip\n");
+        std::exit(1);
+    }
+
+    // Neither legacy PPU snapshots nor simulation-device payloads gain sidecar
+    // bytes. Restore derives both mirrors from authoritative RGB888 state.
+    gbarecomp::debug::SnapshotWriter sidecar_snapshot;
+    f.ppu.serialize(sidecar_snapshot);
+    if (!f.ppu.set_rgb565_sidecar_enabled(false)) std::exit(1);
+    gbarecomp::debug::SnapshotWriter rgb888_snapshot;
+    f.ppu.serialize(rgb888_snapshot);
+    if (sidecar_snapshot.buffer() != rgb888_snapshot.buffer() ||
+        !f.ppu.set_rgb565_sidecar_enabled(true)) {
+        std::fprintf(stderr, "RGB565 sidecar changed snapshot payload\n");
+        std::exit(1);
+    }
+    gba::GbaPpu restored;
+    if (!restored.set_rgb565_sidecar_enabled(true)) std::exit(1);
+    gbarecomp::debug::SnapshotReader reader(
+        sidecar_snapshot.buffer().data(), sidecar_snapshot.size());
+    restored.deserialize(reader);
+    if (!reader.ok() || reader.remaining() ||
+        std::memcmp(restored.latched_framebuffer(), f.ppu.latched_framebuffer(),
+                    gba::GbaPpu::kFramebufferBytes) != 0) {
+        std::fprintf(stderr, "RGB565 snapshot restore failed RGB888 check\n");
+        std::exit(1);
+    }
+    expect_sidecar_matches_rgb888(
+        restored.latched_framebuffer(), restored.latched_framebuffer_rgb565(),
+        gba::GbaPpu::kScreenWidth * gba::GbaPpu::kScreenHeight,
+        "PPU snapshot restored sidecar");
+
+    gba::GbaBus bus;
+    bus.rtc().set_emulated_clock(0);
+    gba::GbaPpu simulation_source;
+    if (!simulation_source.set_rgb565_sidecar_enabled(true)) std::exit(1);
+    simulation_source.latch_framebuffer(0x0414, f.io.data(), f.vram.data(),
+                                        f.oam.data(), f.pal.data());
+    const auto device_payload = gba::save_device_state(bus, simulation_source);
+    if (!simulation_source.set_rgb565_sidecar_enabled(false)) std::exit(1);
+    const auto device_payload_without_sidecar =
+        gba::save_device_state(bus, simulation_source);
+    if (device_payload != device_payload_without_sidecar ||
+        !simulation_source.set_rgb565_sidecar_enabled(true)) {
+        std::fprintf(stderr, "RGB565 sidecar changed simulation-state payload\n");
+        std::exit(1);
+    }
+    gba::GbaBus restored_bus;
+    restored_bus.rtc().set_emulated_clock(0);
+    gba::GbaPpu simulation_restored;
+    if (!simulation_restored.set_rgb565_sidecar_enabled(true) ||
