+void test_rgb565_sidecar_exhaustive_gba_colors() {
+    Fixture f;
+    disable_all_objects(f);
+    set_bg2_identity(f);
+    constexpr std::size_t kColorCount = 32768;
+    constexpr std::size_t kPixels =
+        gba::GbaPpu::kScreenWidth * gba::GbaPpu::kScreenHeight;
+    std::array<uint16_t, kPixels> rgb565{};
+    std::array<uint8_t, gba::GbaPpu::kFramebufferBytes> with_sidecar{};
+
+    // Mode 3 reads little-endian GBA BGR555 words directly from VRAM.
+    // The first 32,768 pixels enumerate every 15-bit color exactly once.
+    for (std::size_t i = 0; i < kPixels; ++i) {
+        const uint16_t color = static_cast<uint16_t>(i < kColorCount ? i : 0);
+        store16(&f.vram[i * 2], color);
+    }
+    f.ppu.render(f.rgb.data(), 0x0403, f.io.data(), f.vram.data(),
+                 f.oam.data(), f.pal.data(), rgb565.data());
+    with_sidecar = f.rgb;
+    expect_sidecar_matches_rgb888(f.rgb.data(), rgb565.data(), kPixels,
+                                  "exhaustive RGB565 sidecar");
+    f.ppu.render(f.rgb.data(), 0x0403, f.io.data(), f.vram.data(),
+                 f.oam.data(), f.pal.data());
+    if (f.rgb != with_sidecar) {
+        std::fprintf(stderr,
+                     "default RGB888 output changed when sidecar is disabled\n");
+        std::exit(1);
+    }
+
+    // Bit 15 is not part of direct-color display output. Verify that the
+    // sidecar follows the existing RGB888 result when it is set on every word.
+    for (std::size_t i = 0; i < kPixels; ++i) {
+        const uint16_t color = static_cast<uint16_t>(0x8000u |
+            static_cast<uint16_t>(i < kColorCount ? i : 0));
+        store16(&f.vram[i * 2], color);
+    }
+    f.ppu.render(f.rgb.data(), 0x0403, f.io.data(), f.vram.data(),
+                 f.oam.data(), f.pal.data(), rgb565.data());
+    expect_sidecar_matches_rgb888(f.rgb.data(), rgb565.data(), kPixels,
+                                  "bit-15 RGB565 sidecar");
