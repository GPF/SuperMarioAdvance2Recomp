+            (gba::GbaPpu::kDotsPerScanline - gba::GbaPpu::kDotsVisible) *
+            gba::GbaPpu::kCyclesPerDot);
+        if (end_line.vblank_started) std::exit(1);
+    }
+    if (std::memcmp(f.ppu.latched_framebuffer(), latched_rgb.data(),
+                    latched_rgb.size()) != 0 ||
+        !std::equal(latched_rgb565.begin(), latched_rgb565.end(),
+                    f.ppu.latched_framebuffer_rgb565())) {
+        std::fprintf(stderr, "in-progress page flip changed the latched frame\n");
+        std::exit(1);
+    }
+    if (f.ppu.work_framebuffer_rgb565()[0] != 0x001Fu ||
+        f.ppu.work_framebuffer_rgb565()[1] != 0x07E0u ||
+        f.ppu.work_framebuffer_rgb565()[
