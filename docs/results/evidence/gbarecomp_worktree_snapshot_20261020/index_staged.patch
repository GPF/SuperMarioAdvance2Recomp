+        std::exit(1);
+    }
+    expect_sidecar_matches_rgb888(
+        simulation_restored.latched_framebuffer(),
+        simulation_restored.latched_framebuffer_rgb565(),
+        gba::GbaPpu::kScreenWidth * gba::GbaPpu::kScreenHeight,
+        "simulation-state restored sidecar");
