+    // The sidecar is generated line-by-line and becomes visible only at the
+    // same VBlank boundary as the authoritative RGB888 latch.
+    render_visible_frame(0x0404, true);
+    expect_sidecar_matches_rgb888(f.ppu.latched_framebuffer(),
+                                  f.ppu.latched_framebuffer_rgb565(),
+                                  gba::GbaPpu::kScreenWidth *
+                                      gba::GbaPpu::kScreenHeight,
