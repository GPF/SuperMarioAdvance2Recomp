+    }
+    void iwram_code_invalidate(const char* why) {
+        if (watch_hi_ && watch_cb_) watch_cb_(watch_user_, why);
+    }
+    uint32_t iwram_code_watch_lo() const { return watch_lo_; }
+    uint32_t iwram_code_watch_hi() const { return watch_hi_; }
