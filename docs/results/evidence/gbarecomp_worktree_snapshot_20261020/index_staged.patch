+// Compile-time switch for the barrier on the store path (1 = present, 0 = compiled out). 0 exists ONLY as a
+// controlled performance ceiling for benchmarking; a build with 0 is not correctness-safe for mutable IWRAM code.
+#ifndef GBARECOMP_IWRAM_CODE_WATCH
+#define GBARECOMP_IWRAM_CODE_WATCH 1
+#endif
+#if GBARECOMP_IWRAM_CODE_WATCH
+#define GBARECOMP_IWRAM_WATCH(off, w, v) \
+    do { if (watch_hi_ && (off) < watch_hi_ && (off) + (w) > watch_lo_) iwram_watch_store((off), (w), (v)); } while (0)
+#else
+#define GBARECOMP_IWRAM_WATCH(off, w, v) do {} while (0)
+#endif
